#!/bin/bash

# jj spcialized for config files

MAIN_BM=main
LOCAL_BM=laptop
LOCAL_START_BM=${LOCAL_BM}_start

function move_bookmark() {
  bookmark=$1
  jj log
  echo -n "Which rev do you want to move the '$bookmark' bookmark to? "
  read target_rev
  jj bookmark move --allow-backwards -t $target_rev $bookmark
}

function rebase_local() {
  jj rebase -r $LOCAL_START_BM:: -o $MAIN_BM
}

function push() {
  jj git push --bookmark main --remote origin
  jj git push --bookmark $LOCAL_BM --remote $LOCAL_BM
}

function show_help() {
  cat <<EOF
Usage: jjc <command> [options]

Commands:
  main    Move the main bookmark to a specific revision.
  local   Move the local bookmark to a specific revision.
  rebase  Rebase local changes onto the main bookmark.
  push    Push main and local bookmarks to their remotes.
  help    Show this help message.
EOF
}

if [ $# -eq 0 ]; then
  show_help
  exit 0
fi

case "$1" in
  main)
    move_bookmark $MAIN_BM
    ;;
  local)
    move_bookmark $LOCAL_BM
    ;;
  rebase)
    rebase_local
    ;;
  push)
    push
    ;;
  help|--help|-h)
    show_help
    ;;
  *)
    echo "Unknown command: $1"
    show_help
    exit 1
    ;;
esac

